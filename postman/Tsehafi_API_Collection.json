    {
      "name": "5. Cohort Enrolments & Concessions",
      "item": [
        {
          "name": "Enrol Student in Batch (with Discount Tracking)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('enrolmentId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"{{studentId}}\",\n  \"batchId\": \"{{batchId}}\",\n  \"fee\": 3500,\n  \"discount\": 500,\n  \"discountReason\": \"Sibling Concession (የቤተሰብ ቅናሽ)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrolments",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrolments"]
            }
          }
        },
        {
          "name": "List Enrolments (Filter by Batch or Student)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/enrolments?batchId={{batchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrolments"],
              "query": [
                { "key": "batchId", "value": "{{batchId}}" },
                { "key": "studentId", "value": "{{studentId}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Transfer Student to Another Batch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetBatchId\": \"{{batchId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/enrolments/{{enrolmentId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "enrolments", "{{enrolmentId}}", "transfer"]
            }
          }
        },
