{
  "info": {
    "_postman_id": "tsehafi-tam-v1-collection",
    "name": "Tsehafi (ጸሐፊ) TAM SaaS API",
    "description": "Comprehensive Postman collection for Training Academy Management (TAM) SaaS — Phases 1 & 2.\nIncludes Authentication, Multi-tenant Isolation, Students Directory, Courses, Rooms, Trainers, Batches with Ethiopian Holiday Skipping, Timetable, Enrolments, and Bulk Roster Import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "",
      "type": "string"
    },
    {
      "key": "trainerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "batchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "enrolmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "attendanceRecordId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Tenancy",
      "item": [
        {
          "name": "Register Academy (New Tenant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('authToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academyName\": \"Abyssinia Arts Academy\",\n  \"academyNameAm\": \"አቢሲኒያ የኪነ-ጥበብ አካዳሚ\",\n  \"slug\": \"abyssinia-arts\",\n  \"ownerName\": \"Tewodros Kassahun\",\n  \"ownerPhone\": \"0911778899\",\n  \"ownerEmail\": \"teddy@abyssinia-arts.et\",\n  \"password\": \"AbyssiniaPass123!\",\n  \"defaultLocale\": \"am\",\n  \"defaultCalendar\": \"ETHIOPIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register-academy",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register-academy"]
            }
          }
        },
        {
          "name": "Login (Owner / Cashier / Trainer)",
          "event": [
