// Prisma schema for Training Academy Management (Tsehafi)
// PostgreSQL datasource configured for multi-tenancy and audit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum Role {
  OWNER
  ADMIN
  REGISTRAR
  CASHIER
  TRAINER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  FROZEN
}

enum Sex {
  MALE
  FEMALE
}

enum BatchStatus {
  DRAFT
  ENROLLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EnrolmentStatus {
  ENROLLED
  TRANSFERRED
  DROPPED
  FROZEN
}

enum AttendStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum PayMethod {
  CASH
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  POSTED
  VOIDED
}

enum LedgerKind {
  CHARGE
  PAYMENT
  DISCOUNT
  VOID
  REFUND
}

enum InstalmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum CertStatus {
  ISSUED
  REVOKED
}

enum CalendarKind {
  ETHIOPIAN
  GREGORIAN
}

enum Locale {
  am
  en
  om
  ti
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model Tenant {
  id              String        @id @default(uuid())
  name            String
  nameAm          String?
  type            String?
  city            String?
  subcity         String?
  phone           String?
  tin             String?
  defaultLocale   Locale        @default(am)
  defaultCalendar CalendarKind  @default(ETHIOPIAN)
  timezone        String        @default("Africa/Addis_Ababa")
  status          TenantStatus  @default(TRIAL)
  planId          String?
  smsCredits      Int           @default(200)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships          Membership[]
  students             Student[]
  courses              Course[]
  trainers             Trainer[]
  rooms                Room[]
  batches              Batch[]
  sessions             Session[]
  enrolments           Enrolment[]
  payments             Payment[]
  certificates         Certificate[]
  ledgerEntries        LedgerEntry[]
  instalments          Instalment[]
  receipts             Receipt[]
  smsTemplates         SmsTemplate[]
  notificationSettings NotificationSettings?
  smsLogs              SmsLog[]
  inAppNotifications   InAppNotification[]
}

model User {
  id           String        @id @default(uuid())
  phone        String?       @unique
  email        String?       @unique
  passwordHash String?
  name         String
  nameAm       String?
  locale       Locale?
  theme        Theme?
  calendar     CalendarKind?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships        Membership[]
  trainers           Trainer[]
  inAppNotifications InAppNotification[]
}

model Membership {
  id        String       @id @default(uuid())
  tenantId  String
  userId    String
  role      Role
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model Student {
  id            String        @id @default(uuid())
  tenantId      String
  studentNo     String
  firstName     String
  lastName      String
  firstNameAm   String?
  lastNameAm    String?
  sex           Sex?
  dob           DateTime?     @db.Date
  phone         String?
  phoneNorm     String?
  guardianName  String?
  guardianPhone String?
  address       String?
  status        StudentStatus @default(ACTIVE)
  photoKey      String?
  smsConsent    Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrolments    Enrolment[]
  payments      Payment[]
  certificates  Certificate[]
  ledgerEntries LedgerEntry[]
  smsLogs       SmsLog[]

  @@unique([tenantId, studentNo])
  @@index([tenantId, phoneNorm])
}

model Course {
  id                    String        @id @default(uuid())
  tenantId              String
  name                  String
  nameAm                String?
  durationDays          Int?
  totalHours            Int?
  defaultFeeMinor       BigInt        @default(0)
  requiredAttendancePct Int           @default(80)
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches               Batch[]
}

model Trainer {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  name      String
  nameAm    String?
  phone     String?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  batches   Batch[]
  sessions  Session[]
}

model Room {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  capacity  Int?
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches   Batch[]
  sessions  Session[]
}

model Batch {
  id        String      @id @default(uuid())
  tenantId  String
  code      String
  courseId  String
  trainerId String?
  roomId    String?
  capacity  Int
  startDate DateTime    @db.Date
  endDate   DateTime?   @db.Date
  status    BatchStatus @default(DRAFT)
  pattern   Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer   Trainer?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  room      Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sessions  Session[]
  enrolments Enrolment[]
  certificates Certificate[]

  @@unique([tenantId, code])
}

model Session {
  id        String        @id @default(uuid())
  tenantId  String
  batchId   String
  date      DateTime      @db.Date
  startTime String
  endTime   String
  roomId    String?
  trainerId String?
  status    SessionStatus @default(SCHEDULED)
  note      String?
  createdAt DateTime      @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch     Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  room      Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  trainer   Trainer?      @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  attendances AttendanceRecord[]

  @@index([tenantId, batchId, date])
}

model Enrolment {
  id             String          @id @default(uuid())
  tenantId       String
  studentId      String
  batchId        String
  enrolledOn     DateTime        @db.Date
  status         EnrolmentStatus @default(ENROLLED)
  feeMinor       BigInt
  discountMinor  BigInt          @default(0)
  discountReason String?
  droppedOn      DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch          Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instalments    Instalment[]

  @@unique([tenantId, studentId, batchId])
}

model AttendanceRecord {
  id         String       @id @default(uuid())
  tenantId   String
  sessionId  String
  studentId  String
  status     AttendStatus
  note       String?
  markedById String
  markedAt   DateTime     @default(now())
  editedAt   DateTime?
  editReason String?
  clientId   String?

  session    Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionId, studentId])
}

model Payment {
  id           String        @id @default(uuid())
  tenantId     String
  studentId    String
  amountMinor  BigInt
  method       PayMethod
  reference    String?
  paidOn       DateTime      @db.Date
  receivedById String
  status       PaymentStatus @default(POSTED)
  voidReason   String?
  createdAt    DateTime      @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receipt      Receipt?
  allocations  PaymentAllocation[]

  @@unique([tenantId, method, reference])
}

model Certificate {
  id            String     @id @default(uuid())
  tenantId      String
  studentId     String
  batchId       String
  number        String
  issuedOn      DateTime   @db.Date
  status        CertStatus @default(ISSUED)
  verifyToken   String     @unique
  pdfKey        String?
  revokedReason String?
  createdAt     DateTime   @default(now())

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch         Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
}

model LedgerEntry {
  id          String     @id @default(uuid())
  tenantId    String
  studentId   String
  enrolmentId String?
  kind        LedgerKind
  amountMinor BigInt     // + charge, - payment/discount
  refType     String     // "PAYMENT", "ENROLMENT", "VOID", "DISCOUNT"
  refId       String
  occurredOn  DateTime   @db.Date
  createdAt   DateTime   @default(now())

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([tenantId, occurredOn])
}

model Instalment {
  id          String           @id @default(uuid())
  tenantId    String
  enrolmentId String
  seq         Int
  dueDate     DateTime         @db.Date
  amountMinor BigInt
  paidMinor   BigInt           @default(0)
  status      InstalmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrolment   Enrolment        @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([tenantId, enrolmentId, seq])
}

model PaymentAllocation {
  id           String     @id @default(uuid())
  tenantId     String
  paymentId    String
  instalmentId String
  amountMinor  BigInt
  createdAt    DateTime   @default(now())

  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  instalment   Instalment @relation(fields: [instalmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentId])
}

model Receipt {
  id           String    @id @default(uuid())
  tenantId     String
  paymentId    String    @unique
  number       Int       // Gapless sequential per tenant per Ethiopian year
  year         Int       // e.g. 2017
  printedAt    DateTime?
  reprintCount Int       @default(0)
  pdfKey       String?
  createdAt    DateTime  @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment      Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, number])
}

model ReceiptCounter {
  tenantId String
  year     Int
  next     Int

  @@id([tenantId, year])
}

model CertificateCounter {
  tenantId String
  year     Int
  next     Int

  @@id([tenantId, year])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
}

enum SmsTriggerType {
  PAYMENT_REMINDER_DUE
  PAYMENT_OVERDUE
  ABSENCE_ALERT
  PAYMENT_CONFIRMATION
  BATCH_BROADCAST
  GENERAL_ANNOUNCEMENT
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SUPPRESSED_QUIET_HOURS
}

enum NotificationType {
  PAYMENT
  ATTENDANCE
  CREDIT_LOW
  SYSTEM
}

model SmsTemplate {
  id          String         @id @default(uuid())
  tenantId    String
  triggerType SmsTriggerType
  name        String
  contentAm   String
  contentEn   String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, triggerType])
}

model NotificationSettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  remindBeforeDueDays Int      @default(3)
  remindOnDueDate     Boolean  @default(true)
  remindWhenOverdue   Boolean  @default(true)
  remindOverdueDays   Int      @default(7)
  notifyAbsence       Boolean  @default(true)
  quietHoursEnabled   Boolean  @default(true)
  quietHoursStart     String   @default("20:00")
  quietHoursEnd       String   @default("07:00")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SmsLog {
  id             String         @id @default(uuid())
  tenantId       String
  studentId      String?
  recipientPhone String
  recipientName  String?
  message        String
  segments       Int            @default(1)
  creditsUsed    Int            @default(1)
  triggerType    SmsTriggerType
  status         SmsStatus      @default(SENT)
  providerRef    String?
  errorMessage   String?
  createdAt      DateTime       @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, triggerType])
}

model InAppNotification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String?
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, isRead])
  @@index([tenantId, createdAt])
}
